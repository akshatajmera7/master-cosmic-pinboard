{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
      {
        "source": "/api/sync",
        "destination": "/api/sync.js"
      },
      {
        "source": "/api/(.*)",
        "destination": "/api/$1"
      },
      {
        "source": "/api",
        "destination": "/api/index.js"
      },
      {
        "source": "/((?!api/|.*\\..*).*)",
        "destination": "/index.html"
      }
    ]
  }